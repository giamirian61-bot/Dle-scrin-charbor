# HTTPS address of YOUR self-hosted Stream Harbor controller.
# Avoid provider-specific hostnames in the reusable worker configuration.
# The endpoint must have a valid TLS certificate and enforce worker authentication.
CONTROLLER_URL=https://your-stream-harbor-domain.example

# Must match WORKER_AGENT_TOKEN on the controller.
WORKER_AGENT_TOKEN=replace-me

# First production worker can own all 8 slots.
WORKER_NODE_ID=worker-a

# Local SSD/NVMe cache.
WORKER_CACHE_DIR=/var/lib/stream-harbor-cache
WORKER_CACHE_QUOTA_BYTES=107374182400
WORKER_CACHE_RESERVE_BYTES=536870912

WORKER_POLL_MS=3000
WORKER_STATUS_MS=5000
